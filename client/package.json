{
  "name": "ledgerling-client",
  "private": true,
  "version": "1.0.0",
  "description": "Ledgerling web app: React 19 + Vite, installable PWA, 8 languages. Course project, Phát triển ứng dụng web và cơ sở dữ liệu (CSBU109.R11.KHBC), UIT",
  "keywords": [
    "expense-tracker",
    "personal-finance",
    "react",
    "vite",
    "pwa",
    "i18next",
    "recharts",
    "socket-io-client",
    "playwright"
  ],
  "homepage": "https://ledgerling-ten.vercel.app",
  "bugs": {
    "url": "https://github.com/minhtriqn05/ledgerling/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minhtriqn05/ledgerling.git",
    "directory": "client"
  },
  "author": {
    "name": "Nguyễn Minh Trí",
    "url": "https://github.com/minhtriqn05"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e:chromium && npm run test:e2e:smoke",
    "test:e2e:chromium": "playwright test --project=desktop --project=mobile",
    "test:e2e:smoke": "playwright test --project=firefox --project=webkit",
    "test:e2e:live": "playwright test -c playwright.live.config.js",
    "generate-pwa-assets": "pwa-assets-generator",
    "i18n:check": "node scripts/i18n-check.js",
    "og-image": "node scripts/capture-og.mjs",
    "screenshots": "playwright test -c playwright.screenshots.config.js --grep \"landing page pictures\"",
    "screenshots:docs": "playwright test -c playwright.screenshots.config.js docs-screenshots"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "i18next": "^26.5.12",
    "i18next-browser-languagedetector": "^8.2.4",
    "lucide-react": "^1.65.0",
    "motion": "^14.9.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
