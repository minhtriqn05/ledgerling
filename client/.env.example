# The API base URL, with /api at the end. On Vercel: https://ledgerling-api.onrender.com/api
VITE_API_URL=http://localhost:4000/api
# Optional. The public address of the site, for the canonical link and the share cards (Open Graph). Without it the build
# uses the production address Vercel gives it, else https://ledgerling-ten.vercel.app (client/scripts/siteAddress.js).
# VITE_SITE_URL=https://ledgerling-ten.vercel.app
