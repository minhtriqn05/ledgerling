# https://editorconfig.org – the same style as the code: 2 spaces, LF, UTF-8
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two spaces at the end of a line are a line break in Markdown
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
