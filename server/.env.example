PORT=4000
# The MongoDB database (Atlas: mongodb+srv://user:password@cluster.mongodb.net/ledgerling)
MONGODB_URI=
# A long random string that signs the tokens
JWT_SECRET=
# How long a token is valid (12h, 7d, ...). Default 7d.
JWT_EXPIRES_IN=7d
# The addresses of the app allowed to call the API (CORS and Socket.IO), comma-separated.
# On Render: https://ledgerling-ten.vercel.app
CLIENT_URL=http://localhost:5173
# Optional. Use production on Render; leave it out on your computer.
# Rate limits (src/app.js) are on in every mode except NODE_ENV=test.
# NODE_ENV=production
# Password of the demo account (demo@example.com) made by `npm run seed`. At least 6 characters.
# The "Try the demo" button signs in without it, so it is only for you if you want to log in by hand.
DEMO_PASSWORD=
# Set by Render itself, nothing to do: GET /api/health shows it as "version".
# RENDER_GIT_COMMIT=
