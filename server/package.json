    "mongodb",
    "mongoose",
    "jwt",
    "socket-io",
    "swagger",
    "vitest"
  ],
  "homepage": "https://ledgerling-ten.vercel.app",
  "bugs": {
    "url": "https://github.com/minhtriqn05/ledgerling/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minhtriqn05/ledgerling.git",
    "directory": "server"
  },
  "author": {
    "name": "Nguyễn Minh Trí",
    "url": "https://github.com/minhtriqn05"
  },
  "license": "MIT",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "start:e2e": "node src/e2e.js",
    "make-admin": "node src/scripts/make-admin.js",
    "seed": "node src/seed.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0"
  },
