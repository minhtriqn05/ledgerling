{
  "name": "ledgerling-server",
  "version": "1.0.0",
  "description": "Ledgerling REST API: Node.js + Express 5 + MongoDB (Mongoose), JWT auth, Socket.IO, Swagger. Course project, Phát triển ứng dụng web và cơ sở dữ liệu (CSBU109.R11.KHBC), UIT",
  "keywords": [
    "expense-tracker",
    "rest-api",
